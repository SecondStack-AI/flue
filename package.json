{
	"name": "flue",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"packageManager": "pnpm@11.1.1",
	"engines": {
		"node": ">=22",
		"pnpm": ">=11 <12"
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"test": "turbo test",
		"test:integration": "pnpm --dir packages/vite run test:integration:cloudflare",
		"check": "turbo run build check:lint check:types && turbo run test",
		"check:lint": "biome lint . && knip",
		"check:knip": "knip",
		"check:types": "turbo run check:types --filter=!apps-www",
		"format": "turbo run format:lint format:style",
		"format:lint": "biome check . --write",
		"format:style": "prettier . --cache --write --list-different"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@flue/runtime": "workspace:*",
		"@types/node": "26.1.2",
		"bgproc": "0.3.0",
		"knip": "6.29.0",
		"prettier": "3.9.6",
		"turbo": "2.10.7",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"just-bash": "3.2.0",
		"valibot": "1.4.2"
	}
}
