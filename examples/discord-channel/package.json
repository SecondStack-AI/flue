		"valibot": "1.4.2"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.19.1",
		"@flue/cli": "workspace:*",
		"@flue/vite": "workspace:*",
		"typescript": "7.0.2",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	}
}
