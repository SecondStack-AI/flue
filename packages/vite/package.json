{
	"name": "@flue/vite",
	"version": "2.3.0",
	"type": "module",
	"license": "Apache-2.0",
	"homepage": "https://flueframework.com/",
	"repository": {
		"type": "git",
		"url": "https://github.com/withastro/flue",
		"directory": "packages/vite"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./internal": {
			"types": "./dist/internal.d.mts",
			"import": "./dist/internal.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc --noEmit",
		"test": "vitest run",
		"test:integration:cloudflare": "vitest run --config vitest.integration.cloudflare.config.ts --no-file-parallelism",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@flue/runtime": "workspace:*",
		"@hono/node-server": "2.0.12",
		"agents": "0.20.1",
		"magic-string": "1.1.0",
		"tinyglobby": "0.2.17",
		"ulidx": "2.4.1"
	},
	"peerDependencies": {
		"vite": "^8.0.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.49.0",
		"@earendil-works/pi-ai": "1.1.0",
		"hono": "4.12.32",
		"tsdown": "0.22.14",
		"typescript": "7.0.2",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	}
}
